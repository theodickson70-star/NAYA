# Nakili kuwa .env kwa kompyuta yako TU. Kamwe usiweke .env kwenye GitHub.
# Kwenye Railway, weka hizi kwenye Variables.

# Supabase → Project → Connect → "Session pooler" (port 5432). Weka password yako halisi badala ya [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

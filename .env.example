# Nakili kuwa .env kwa kompyuta yako TU. Kamwe usiweke .env kwenye GitHub.
# Kwenye Railway, weka hizi kwenye Variables (Railway inaweka PORT yenyewe).

# --- LAZIMA ---
# Supabase → Project → Connect → "Session pooler" (port 5432). Weka password yako halisi.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Siri ya kusaini tokens za login: angalau herufi 32, za nasibu.
# PowerShell:  -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
JWT_SECRET=WEKA_SIRI_NDEFU_YA_NASIBU_HAPA

# --- SI LAZIMA ---
# Muda wa login kabla ya kuingia upya (default 7d)
JWT_EXPIRES_IN=7d
# Kwa kompyuta yako tu; Railway inaweka PORT yenyewe
PORT=8080
# Tovuti nyingine zinazoruhusiwa kuita API (tenganisha kwa koma). Wacha tupu ikiwa kurasa ziko kwenye server hii hii.
CORS_ORIGIN=

# Arifa za Web Push (simu ilie hata app ikiwa imefungwa). Zitengeneze MARA MOJA kwa: npm run vapid-keys
# Usizibadilishe baadaye — simu zilizokwisha kukubali arifa zingeacha kupokea.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:barua-pepe-yako@mfano.com

# Zitatumika kwenye phases zijazo (AI). Usiziweke kwenye frontend.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=

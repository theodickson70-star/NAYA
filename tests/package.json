{
  "name": "paypoint",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "PayPoint — Kituo Chako cha Pesa. Mfumo wa usimamizi wa uwakala wa kutuma na kutoa pesa.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}

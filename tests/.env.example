# Nakili kuwa .env kwa kompyuta yako tu (usiweke .env kwenye GitHub).
# Kwenye Railway, weka hizi kwenye Variables.

# Supabase ileile ya NAYA (Project Settings > Database > Connection string, "Session pooler")
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-xx.pooler.supabase.com:5432/postgres

# Railway inaweka PORT yenyewe. Kwa kompyuta yako:
PORT=3000

# Kwa kompyuta yako tu (http://localhost). Kwenye Railway USIIWEKE.
COOKIE_SECURE=false

{
  "name": "naya-api",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "NAYA — Twende Pamoja. API ya usafiri wa bodaboda na bajaji.",
  "scripts": {
    "dev": "tsc -p tsconfig.json && node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "migrate": "tsx src/scripts/migrate.ts",
    "create-admin": "tsx src/scripts/create-admin.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=20.12"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
